<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ── Overlay: backgrounds (60% opacity = alpha #99) ───────────────────── -->
    <SolidColorBrush x:Key="Overlay.Background"           Color="#99232932"/>
    <SolidColorBrush x:Key="Overlay.CollapsedBorder"      Color="#99455060"/>

    <!-- ── Overlay: idle state ───────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Overlay.Idle.Hover"           Color="#992d3642"/>
    <SolidColorBrush x:Key="Overlay.Idle.Pressed"         Color="#991a222c"/>
    <SolidColorBrush x:Key="Overlay.MicIcon"              Color="#DCE2E3"/>

    <!-- ── Overlay: recording ────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Overlay.RecordDot"            Color="#F44649"/>
    <!-- rgba(217,217,217,0.43) — silence dots; alpha baked in (0x6E ≈ 110/255) -->
    <SolidColorBrush x:Key="Overlay.SilenceDot"           Color="#6ED9D9D9"/>

    <!-- ── Overlay: send button ──────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Overlay.SendButton.Fill"      Color="#D9D9D9"/>
    <SolidColorBrush x:Key="Overlay.SendButton.Icon"      Color="#1A2029"/>

    <!-- ── Overlay: processing dots ──────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Overlay.ProcDot.Primary"      Color="#BFBFBF"/>
    <SolidColorBrush x:Key="Overlay.ProcDot.Secondary"    Color="#747474"/>

    <!-- ── Overlay: corner radii ─────────────────────────────────────────────── -->
    <CornerRadius x:Key="Overlay.Pill.CornerRadius">14</CornerRadius>
    <CornerRadius x:Key="Overlay.Collapsed.CornerRadius">3.5</CornerRadius>

    <!-- ── Overlay: sizes (from Figma / tokens.md) ───────────────────────────── -->
    <sys:Double x:Key="Overlay.Collapsed.Width">51</sys:Double>
    <sys:Double x:Key="Overlay.Collapsed.Height">7</sys:Double>
    <sys:Double x:Key="Overlay.Idle.Width">51</sys:Double>
    <sys:Double x:Key="Overlay.Idle.Height">28</sys:Double>
    <sys:Double x:Key="Overlay.Active.Width">81</sys:Double>
    <sys:Double x:Key="Overlay.Active.Height">28</sys:Double>
    <sys:Double x:Key="Overlay.Dot.Size">4</sys:Double>
    <sys:Double x:Key="Overlay.SendButton.Size">18</sys:Double>

</ResourceDictionary>
