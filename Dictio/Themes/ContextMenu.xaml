<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Initial dark-mode values; ThemeService.UpdateAppResources() replaces at runtime. -->
    <SolidColorBrush x:Key="Menu.Background"        Color="#1e2330"/>
    <SolidColorBrush x:Key="Menu.Border"            Color="#2d3748"/>
    <SolidColorBrush x:Key="Menu.Foreground"        Color="#e2e8f0"/>
    <SolidColorBrush x:Key="Menu.Foreground.Muted"  Color="#94a3b8"/>
    <SolidColorBrush x:Key="Menu.Item.Hover"        Color="#2d3748"/>
    <SolidColorBrush x:Key="Menu.Item.Checked"      Color="#3b82f6"/>

    <Geometry x:Key="SubArrow">M 0 0 L 4 4 L 0 8</Geometry>
    <Geometry x:Key="CheckMark">M 1 5 L 3.5 7.5 L 8 2</Geometry>

    <!-- ── ContextMenu ──────────────────────────────────────────────────────── -->
    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels"   Value="True"/>
        <!-- Plain StackPanel: no WPF shared-size column scope that offsets separators -->
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel IsItemsHost="True"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border Background="{DynamicResource Menu.Background}"
                            BorderBrush="{DynamicResource Menu.Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="0,5"
                            MinWidth="160">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="24"
                                              ShadowDepth="6" Opacity="0.45"
                                              Direction="270"/>
                        </Border.Effect>
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Separator — full-width 1px rule ──────────────────────────────────── -->
    <!-- WPF menus look up separators via MenuItem.SeparatorStyleKey (not plain TargetType),
         which defaults to Margin="29,2,2,2" to clear the icon column. Override both. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HorizontalAlignment"   Value="Stretch"/>
        <Setter Property="Height"                Value="7"/>
        <Setter Property="Margin"                Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Height="1"
                            Background="{DynamicResource Menu.Border}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── MenuItem ─────────────────────────────────────────────────────────── -->
    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels"   Value="True"/>
        <Setter Property="Foreground"            Value="{DynamicResource Menu.Foreground}"/>
        <Setter Property="Background"            Value="Transparent"/>
        <Setter Property="Height"                Value="34"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Grid>
                        <Border x:Name="Highlight"
                                Background="Transparent"
                                CornerRadius="6"
                                Margin="5,1"/>

                        <DockPanel Margin="10,0,10,0">
                            <Path x:Name="CheckIcon"
                                  DockPanel.Dock="Left"
                                  Data="{StaticResource CheckMark}"
                                  Width="14" Height="14" Stretch="Uniform"
                                  Stroke="{DynamicResource Menu.Item.Checked}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"
                                  Visibility="Collapsed"/>

                            <Path x:Name="SubArrowIcon"
                                  DockPanel.Dock="Right"
                                  Data="{StaticResource SubArrow}"
                                  Width="7" Height="10" Stretch="Uniform"
                                  Stroke="{DynamicResource Menu.Foreground.Muted}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed"/>

                            <ContentPresenter ContentSource="Header"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontSize="13"
                                              Margin="2,0,0,0"/>
                        </DockPanel>

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Right"
                               VerticalOffset="-6"
                               HorizontalOffset="2"
                               IsOpen="{Binding IsSubmenuOpen,
                                        RelativeSource={RelativeSource TemplatedParent}}"
                               PopupAnimation="Fade"
                               Focusable="False">
                            <Border Background="{DynamicResource Menu.Background}"
                                    BorderBrush="{DynamicResource Menu.Border}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="0,5"
                                    MinWidth="160">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="24"
                                                      ShadowDepth="6" Opacity="0.45"
                                                      Direction="270"/>
                                </Border.Effect>
                                <ItemsPresenter/>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Highlight" Property="Background"
                                    Value="{DynamicResource Menu.Item.Hover}"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="SubArrowIcon" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Menu.Foreground.Muted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
