<ui:FluentWindow x:Class="Dictio.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Welcome to Dictio"
        Width="500" Height="580"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Icon="pack://application:,,,/Assets/Logo/dictio.ico"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Background="Transparent"
        Loaded="WelcomeWindow_Loaded">

    <ui:FluentWindow.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#1E78E6"/>

        <Style x:Key="SecHdr" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin"     Value="0,16,0,5"/>
        </Style>

        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background"       Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush"      Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="CornerRadius"     Value="8"/>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height"   Value="34"/>
            <Setter Property="Padding"  Value="20,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor"   Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="6" Background="#1E78E6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1568C8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Height"   Value="34"/>
            <Setter Property="Padding"  Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor"   Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="6"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallBtn" TargetType="Button">
            <Setter Property="Width"   Value="28"/>
            <Setter Property="Height"  Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor"  Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mode segment button — inactive -->
        <Style x:Key="ModeBtn" TargetType="Button">
            <Setter Property="Height"  Value="34"/>
            <Setter Property="Width"   Value="150"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor"  Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <ui:TitleBar Grid.Row="0" Title="Welcome to Dictio" Height="32">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/Logo/dictio.ico"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Main layout -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── STEP 1 ──────────────────────────────────────────────────── -->
            <ScrollViewer x:Name="Step1Panel" Grid.Row="0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,20,28,4">

                    <!-- Step indicator -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Ellipse x:Name="Dot1" Width="8" Height="8"
                                 Fill="#1E78E6" VerticalAlignment="Center"/>
                        <Rectangle Width="32" Height="2" VerticalAlignment="Center"
                                   Margin="4,0"
                                   Fill="{DynamicResource DividerStrokeColorDefaultBrush}"/>
                        <Ellipse x:Name="Dot2" Width="8" Height="8"
                                 Fill="{DynamicResource DividerStrokeColorDefaultBrush}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Step 1 of 2" FontSize="11" Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <TextBlock Text="Welcome to Dictio"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Set up your preferences to get started."
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,4"/>

                    <!-- SHORTCUT -->
                    <TextBlock Text="SHORTCUT" Style="{StaticResource SecHdr}"/>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <Grid Height="50" Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Keyboard shortcut" FontSize="13"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Press Edit, then type the combination you want"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Border x:Name="HotkeyCaptureBorder"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4" Padding="10,5"
                                            Margin="0,0,6,0" Focusable="True">
                                        <TextBlock x:Name="HotkeyDisplayText"
                                                   FontFamily="Consolas" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </Border>
                                    <Button Content="Edit"
                                            Style="{StaticResource SecondaryBtn}"
                                            Height="30" Padding="10,0"
                                            Click="EditHotkey_Click"
                                            ToolTip="Click, then press the new shortcut"/>
                                </StackPanel>
                            </Grid>
                            <Rectangle Height="1" Fill="{DynamicResource DividerStrokeColorDefaultBrush}"/>
                            <Grid Height="50" Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Recording mode" FontSize="13"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Toggle: press once.  Push to Talk: hold while recording."
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <!-- Segmented mode selector -->
                                <Border Grid.Column="1" VerticalAlignment="Center"
                                        Margin="12,0,0,0"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6"
                                        ClipToBounds="True">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="ModeToggleBtn"
                                                Content="Toggle"
                                                Style="{StaticResource ModeBtn}"
                                                Click="ModeToggle_Click"
                                                BorderThickness="0,0,1,0"/>
                                        <Button x:Name="ModePttBtn"
                                                Content="Push to Talk"
                                                Style="{StaticResource ModeBtn}"
                                                Click="ModePtt_Click"
                                                BorderThickness="0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- LANGUAGE -->
                    <TextBlock Text="LANGUAGE" Style="{StaticResource SecHdr}"/>
                    <Border Style="{StaticResource SettingsCard}">
                        <Grid Height="50" Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Transcription language" FontSize="13"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="The language you will speak in — or Auto to detect"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ComboBox x:Name="LanguageCombo" Grid.Column="1"
                                      Width="175" VerticalAlignment="Center" Margin="12,0,0,0">
                                <ComboBoxItem Content="Auto (detect)" Tag="Auto"/>
                                <ComboBoxItem Content="English"       Tag="English"/>
                                <ComboBoxItem Content="Russian"       Tag="Russian"/>
                                <ComboBoxItem Content="Ukrainian"     Tag="Ukrainian"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- MICROPHONE -->
                    <TextBlock Text="MICROPHONE" Style="{StaticResource SecHdr}"/>
                    <Border Style="{StaticResource SettingsCard}">
                        <Grid Height="50" Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Microphone" FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="12,0,0,0">
                                <ComboBox x:Name="MicCombo" Width="200"/>
                                <Button Style="{StaticResource SmallBtn}" Content="↺"
                                        Margin="6,0,0,0" Click="RefreshMic_Click"
                                        ToolTip="Refresh microphone list"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ── STEP 2 ──────────────────────────────────────────────────── -->
            <ScrollViewer x:Name="Step2Panel" Grid.Row="0"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,20,28,4">

                    <!-- Step indicator -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Ellipse Width="8" Height="8"
                                 Fill="{DynamicResource DividerStrokeColorDefaultBrush}"
                                 VerticalAlignment="Center"/>
                        <Rectangle Width="32" Height="2" VerticalAlignment="Center"
                                   Margin="4,0"
                                   Fill="#1E78E6"/>
                        <Ellipse Width="8" Height="8" Fill="#1E78E6"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Step 2 of 2" FontSize="11" Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <TextBlock Text="Choose a transcription model"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="You can change this later in Settings → Models."
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,4"/>

                    <!-- Model list built in code-behind -->
                    <StackPanel x:Name="WelcomeModelsPanel" Margin="0,12,0,0"/>

                    <!-- API key section — shown only when a paid model is selected -->
                    <Border x:Name="ApiKeySection" Visibility="Collapsed"
                            Margin="0,12,0,0"
                            Style="{StaticResource SettingsCard}">
                        <StackPanel Margin="14,12">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="OpenAI API Key"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Border CornerRadius="10" Padding="7,2,7,2"
                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                        Background="#FFF3CD" BorderBrush="#FDE68A"
                                        BorderThickness="1">
                                    <TextBlock Text="Required" FontSize="10" Foreground="#92400E"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Required for gpt-4o-transcribe. Get yours at platform.openai.com"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="ApiKeyBox" Height="34"
                                             VerticalContentAlignment="Center"
                                             Padding="8,0" FontSize="13"/>
                                <TextBox x:Name="ApiKeyVisible" Height="34"
                                         VerticalContentAlignment="Center"
                                         Padding="8,0" FontSize="13"
                                         Visibility="Collapsed"/>
                                <Button Grid.Column="1" Content="👁"
                                        Style="{StaticResource SmallBtn}"
                                        Margin="6,0,0,0" ToolTip="Show / hide key"
                                        Click="ShowApiKey_Click"/>
                            </Grid>
                            <TextBlock Text="🔒  Stored encrypted with Windows DPAPI, never uploaded."
                                       FontSize="10"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ── FOOTER ──────────────────────────────────────────────────── -->
            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="24,11,24,11">
                    <Button x:Name="BackBtn"
                            Content="← Back"
                            Style="{StaticResource SecondaryBtn}"
                            HorizontalAlignment="Left" Width="100"
                            Visibility="Collapsed"
                            Click="Back_Click"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="NextBtn"
                                Content="Next →"
                                Style="{StaticResource PrimaryBtn}"
                                Width="100"
                                Click="Next_Click"/>
                        <Button x:Name="StartBtn"
                                Content="Get started"
                                Style="{StaticResource PrimaryBtn}"
                                Width="120"
                                Visibility="Collapsed"
                                Click="Start_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
