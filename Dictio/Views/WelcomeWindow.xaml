<Window x:Class="Dictio.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Dictio"
        Width="400" Height="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <StackPanel Margin="28,24,28,20">

        <TextBlock Text="Welcome to Dictio" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <StackPanel Margin="0,0,0,10">
            <TextBlock Margin="0,0,0,8">
                <Run FontWeight="SemiBold">🖥  Tray app</Run>
                <Run> — Dictio lives in the system tray (bottom-right corner).</Run>
            </TextBlock>
            <TextBlock Margin="0,0,0,8">
                <Run FontWeight="SemiBold">⌨  Ctrl+Space</Run>
                <Run> — press to start/stop recording, or hold for Push-to-Talk.</Run>
            </TextBlock>
            <TextBlock Margin="0,0,0,8">
                <Run FontWeight="SemiBold">⚙  Settings</Run>
                <Run> — click the tray icon to set your API key, microphone, and mode.</Run>
            </TextBlock>
        </StackPanel>

        <TextBlock Text="Set your OpenAI API key in Settings before first use."
                   Foreground="#888" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,20"/>

        <Button Content="Got it" Width="100" HorizontalAlignment="Right"
                IsDefault="True" Click="GotIt_Click"/>
    </StackPanel>
</Window>
