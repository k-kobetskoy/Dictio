<Window x:Class="Dictio.Views.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dictio — Debug"
        Width="560" Height="520"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="160"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Saved recordings (last 10)"
                   FontWeight="SemiBold" Margin="0,0,0,6"/>

        <!-- Audio list -->
        <ListBox Grid.Row="1" x:Name="AudioList"
                 SelectionChanged="AudioList_SelectionChanged"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" FontFamily="Consolas" FontSize="12"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- VAD params row -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
            <TextBlock Text="Prefix padding ms:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
            <TextBox x:Name="PrefixPaddingBox" Width="60" VerticalAlignment="Center" FontSize="12"/>
            <TextBlock Text="Silence duration ms:" VerticalAlignment="Center" Margin="16,0,6,0" FontSize="12"/>
            <TextBox x:Name="SilenceDurationBox" Width="60" VerticalAlignment="Center" FontSize="12"/>
            <TextBlock Text="(empty = from settings)" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="#888" FontSize="11"/>
        </StackPanel>

        <!-- Controls row -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,8">
            <Button x:Name="RetranscribeBtn" Content="Re-transcribe"
                    Width="120" Margin="0,0,8,0"
                    Click="Retranscribe_Click" IsEnabled="False"/>
            <Button Content="Refresh" Width="80"
                    Click="Refresh_Click"/>
            <TextBlock Text="Temperature:" VerticalAlignment="Center" Margin="16,0,6,0" FontSize="12"/>
            <TextBox x:Name="TemperatureBox" Width="50" VerticalAlignment="Center" FontSize="12"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Margin="12,0,0,0" Foreground="#555" FontSize="12"/>
        </StackPanel>

        <!-- Result -->
        <TextBox Grid.Row="4" x:Name="ResultBox"
                 IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontSize="13" Padding="8"
                 Background="#F8F8F8"/>

        <!-- Bottom -->
        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Open audio folder" Width="130" Margin="0,0,8,0"
                    Click="OpenFolder_Click"/>
            <Button Content="Close" Width="80"
                    Click="Close_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
