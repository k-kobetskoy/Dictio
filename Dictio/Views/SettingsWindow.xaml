<Window x:Class="Dictio.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dictio — Settings"
        Width="760" Height="780"
        MinWidth="640" MinHeight="500"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Loaded="SettingsWindow_Loaded">

    <Window.Resources>
        <!-- ── Accent (same in both themes) ──────────────────────────────────── -->
        <SolidColorBrush x:Key="AccentBrush" Color="#1E78E6"/>

        <!-- ── Sidebar nav item ──────────────────────────────────────────────── -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Padding"    Value="14,9"/>
            <Setter Property="Foreground" Value="{DynamicResource Settings.Fg.Primary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="6" Margin="8,2"
                                Background="Transparent">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource Settings.Nav.Selected.Bg}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected"  Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource Settings.Nav.Hover.Bg}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Animated toggle switch ─────────────────────────────────────────── -->
        <Style x:Key="Toggle" TargetType="ToggleButton">
            <Setter Property="Width"  Value="38"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="38" Height="22" CornerRadius="11"
                                Background="{DynamicResource Toggle.Track.Off}">
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White"
                                     HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbT"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect ShadowDepth="1" BlurRadius="2"
                                                      Opacity="0.25" Direction="270"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#1E78E6"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbT"
                                                             Storyboard.TargetProperty="X"
                                                             To="16" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbT"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Small icon button ──────────────────────────────────────────────── -->
        <Style x:Key="SmallBtn" TargetType="Button">
            <Setter Property="Width"  Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{DynamicResource Settings.Input.Bg}"
                                BorderBrush="{DynamicResource Settings.Input.Border}"
                                BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Settings.Nav.Hover.Bg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Primary button ─────────────────────────────────────────────────── -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height"   Value="32"/>
            <Setter Property="Padding"  Value="20,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor"   Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="6" Background="#1E78E6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1568C8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Secondary button ───────────────────────────────────────────────── -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Height"   Value="32"/>
            <Setter Property="Padding"  Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor"   Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource Settings.Fg.Primary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="6"
                                Background="{DynamicResource Settings.Input.Bg}"
                                BorderBrush="{DynamicResource Settings.Input.Border}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource Settings.Nav.Hover.Bg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Section header ─────────────────────────────────────────────────── -->
        <Style x:Key="SecHdr" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Settings.Fg.Secondary}"/>
            <Setter Property="Margin"     Value="0,18,0,6"/>
        </Style>

        <!-- ── Page title ─────────────────────────────────────────────────────── -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Settings.Fg.Primary}"/>
            <Setter Property="Margin"     Value="0,0,0,3"/>
        </Style>

        <!-- ── Page subtitle ──────────────────────────────────────────────────── -->
        <Style x:Key="PageSub" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Foreground"   Value="{DynamicResource Settings.Fg.Secondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin"       Value="0,0,0,16"/>
        </Style>

        <!-- ── Modern ComboBox ────────────────────────────────────────────────── -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Height"       Value="32"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="Foreground"   Value="{DynamicResource Settings.Fg.Primary}"/>
            <Setter Property="Background"   Value="{DynamicResource Settings.Input.Bg}"/>
            <Setter Property="BorderBrush"  Value="{DynamicResource Settings.Input.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility"   Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"/>
                            <!-- Chevron arrow -->
                            <Path x:Name="arrow"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  Data="M 0 0 L 5 5 L 10 0"
                                  Stroke="{DynamicResource Settings.Fg.Hint}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round"
                                  IsHitTestVisible="False"/>
                            <!-- Selected item display -->
                            <ContentPresenter x:Name="contentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,30,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                            <!-- Invisible toggle covers full control for click -->
                            <ToggleButton IsChecked="{Binding IsDropDownOpen,
                                          RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- Dropdown popup -->
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsDropDownOpen,
                                            RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom" PopupAnimation="Slide" Focusable="False">
                                <Border x:Name="dropBorder"
                                        MinWidth="{Binding ActualWidth,
                                                   RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource Settings.Input.Bg}"
                                        BorderBrush="{DynamicResource Settings.Input.Border}"
                                        BorderThickness="1" CornerRadius="6"
                                        Margin="0,2,0,0" Padding="0,4">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="4" BlurRadius="16"
                                                          Opacity="0.12" Direction="270"/>
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="border" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Height"     Value="32"/>
            <Setter Property="Padding"    Value="10,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Settings.Fg.Primary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4" Margin="4,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Settings.Nav.Hover.Bg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Thin Win11-style scrollbar ────────────────────────────────────── -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width"      Value="6"/>
            <Setter Property="MinWidth"   Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand"
                                                  Opacity="0" Height="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Margin="1,2"
                                                        Background="{DynamicResource Settings.Scrollbar.Thumb}"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand"
                                                  Opacity="0" Height="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height"    Value="6"/>
                    <Setter Property="MinHeight" Value="6"/>
                    <Setter Property="Width"     Value="Auto"/>
                    <Setter Property="MinWidth"  Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.LineLeftCommand"
                                                          Opacity="0" Width="0" Focusable="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border CornerRadius="3" Margin="2,1"
                                                                Background="{DynamicResource Settings.Scrollbar.Thumb}"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.LineRightCommand"
                                                          Opacity="0" Width="0" Focusable="False"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── TextBox / PasswordBox (dark-mode compatible) ──────────────────── -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background"   Value="{DynamicResource Settings.Input.Bg}"/>
            <Setter Property="Foreground"   Value="{DynamicResource Settings.Fg.Primary}"/>
            <Setter Property="BorderBrush"  Value="{DynamicResource Settings.Input.Border}"/>
            <Setter Property="CaretBrush"   Value="{DynamicResource Settings.Fg.Primary}"/>
            <Setter Property="SelectionBrush" Value="#1E78E6"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="Padding"      Value="8,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style TargetType="{x:Type PasswordBox}">
            <Setter Property="Background"  Value="{DynamicResource Settings.Input.Bg}"/>
            <Setter Property="Foreground"  Value="{DynamicResource Settings.Fg.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Settings.Input.Border}"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="Padding"     Value="8,0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="185"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ════════════════════════════════════════════════════════════════════
             SIDEBAR
             ════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource Settings.Sidebar.Bg}"
                BorderBrush="{DynamicResource Settings.Line}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- App branding -->
                <StackPanel DockPanel.Dock="Top" Margin="20,20,20,14">
                    <TextBlock Text="Dictio" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource Settings.Fg.Primary}"/>
                    <TextBlock Text="Settings" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource Settings.Fg.Secondary}"/>
                </StackPanel>

                <!-- Nav list -->
                <ListBox x:Name="NavList" BorderThickness="0" Background="Transparent"
                         SelectionMode="Single" SelectionChanged="NavList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItemStyle}"/>
                    </ListBox.ItemContainerStyle>

                    <ListBoxItem><TextBlock Text="Main"     FontSize="13"/></ListBoxItem>
                    <ListBoxItem><TextBlock Text="Models"   FontSize="13"/></ListBoxItem>
                    <ListBoxItem><TextBlock Text="API Keys" FontSize="13"/></ListBoxItem>
                    <ListBoxItem><TextBlock Text="History"  FontSize="13"/></ListBoxItem>
                    <ListBoxItem><TextBlock Text="Overlay"  FontSize="13"/></ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ════════════════════════════════════════════════════════════════════
             CONTENT AREA
             ════════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Background="{DynamicResource Settings.Content.Bg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── PAGE: MAIN ──────────────────────────────────────────────── -->
            <ScrollViewer x:Name="PageMain" Grid.Row="0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20,24,20">
                    <TextBlock Text="Main" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="General recording and transcription settings."
                               Style="{StaticResource PageSub}"/>

                    <!-- GENERAL -->
                    <TextBlock Text="GENERAL" Style="{StaticResource SecHdr}"/>

                    <!-- Shortcut -->
                    <Grid Height="50">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Transcription Shortcut" FontSize="13"
                                       Foreground="{DynamicResource Settings.Fg.Primary}"/>
                            <TextBlock Text="Keyboard shortcut to start / stop recording"
                                       FontSize="11" Foreground="{DynamicResource Settings.Fg.Hint}"/>
                        </StackPanel>
                        <Border Grid.Column="1"
                                Background="{DynamicResource Settings.Kbd.Bg}"
                                CornerRadius="4" Padding="10,5" VerticalAlignment="Center">
                            <TextBlock Text="Ctrl + Space" FontFamily="Consolas" FontSize="12"
                                       Foreground="{DynamicResource Settings.Kbd.Fg}"/>
                        </Border>
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource Settings.Line}"/>

                    <!-- Recording Mode -->
                    <Grid Height="50">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Recording Mode" FontSize="13"
                                       Foreground="{DynamicResource Settings.Fg.Primary}"/>
                            <TextBlock Text="Toggle: press once to start / stop.  Push to Talk: hold while recording."
                                       FontSize="11" Foreground="{DynamicResource Settings.Fg.Hint}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox x:Name="HotkeyModeCombo" Grid.Column="1"
                                  Width="150" VerticalAlignment="Center" Margin="12,0,0,0">
                            <ComboBoxItem Content="Toggle"       Tag="Toggle"/>
                            <ComboBoxItem Content="Push to Talk" Tag="PushToTalk"/>
                        </ComboBox>
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource Settings.Line}"/>

                    <!-- Microphone -->
                    <Grid Height="50">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Microphone" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Settings.Fg.Primary}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="12,0,0,0">
                            <ComboBox x:Name="AudioDeviceCombo" Width="210"/>
                            <Button Style="{StaticResource SmallBtn}" Content="↺"
                                    Margin="6,0,0,0" Click="RefreshMic_Click"
                                    ToolTip="Refresh microphone list"/>
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource Settings.Line}"/>

                    <!-- Appearance (theme) -->
                    <Grid Height="50">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Appearance" FontSize="13"
                                       Foreground="{DynamicResource Settings.Fg.Primary}"/>
                            <TextBlock Text="Light, dark, or follow the system setting"
                                       FontSize="11" Foreground="{DynamicResource Settings.Fg.Hint}"/>
                        </StackPanel>
                        <ComboBox x:Name="ThemeCombo" Grid.Column="1"
                                  Width="175" VerticalAlignment="Center" Margin="12,0,0,0">
                            <ComboBoxItem Content="Auto (system)" Tag="System"/>
                            <ComboBoxItem Content="Light"         Tag="Light"/>
                            <ComboBoxItem Content="Dark"          Tag="Dark"/>
                        </ComboBox>
                    </Grid>

                    <!-- LANGUAGE -->
                    <TextBlock Text="LANGUAGE" Style="{StaticResource SecHdr}"/>

                    <!-- Language -->
                    <Grid Height="50">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Transcription Language" FontSize="13"
                                       Foreground="{DynamicResource Settings.Fg.Primary}"/>
                            <TextBlock x:Name="LangHintText" FontSize="11"
                                       Foreground="{DynamicResource Settings.Fg.Hint}"/>
                        </StackPanel>
                        <ComboBox x:Name="LanguageCombo" Grid.Column="1"
                                  Width="175" VerticalAlignment="Center" Margin="12,0,0,0"
                                  SelectionChanged="LanguageCombo_SelectionChanged">
                            <ComboBoxItem Content="Auto (detect)" Tag="Auto"/>
                            <ComboBoxItem Content="English"       Tag="English"/>
                            <ComboBoxItem Content="Russian"       Tag="Russian"/>
                            <ComboBoxItem Content="Ukrainian"     Tag="Ukrainian"/>
                        </ComboBox>
                    </Grid>

                    <!-- BEHAVIOR -->
                    <TextBlock Text="BEHAVIOR" Style="{StaticResource SecHdr}"/>

                    <!-- Start with Windows -->
                    <Grid Height="46">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Start with Windows" FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Settings.Fg.Primary}"/>
                        <ToggleButton x:Name="StartWithWindowsToggle" Grid.Column="1"
                                      Style="{StaticResource Toggle}" VerticalAlignment="Center"/>
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource Settings.Line}"/>

                    <!-- Start minimized -->
                    <Grid Height="52">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Start minimized" FontSize="13"
                                       Foreground="{DynamicResource Settings.Fg.Primary}"/>
                            <TextBlock Text="Hide the overlay when the app starts"
                                       FontSize="11" Foreground="{DynamicResource Settings.Fg.Hint}"/>
                        </StackPanel>
                        <ToggleButton x:Name="HideOnStartToggle" Grid.Column="1"
                                      Style="{StaticResource Toggle}" VerticalAlignment="Center"/>
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource Settings.Line}"/>

                    <!-- Show tray icon -->
                    <Grid Height="46">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Show tray icon" FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Settings.Fg.Primary}"/>
                        <ToggleButton x:Name="ShowTrayIconToggle" Grid.Column="1"
                                      Style="{StaticResource Toggle}" VerticalAlignment="Center"/>
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource Settings.Line}"/>

                    <!-- Restore clipboard -->
                    <Grid Height="52">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Restore clipboard" FontSize="13"
                                       Foreground="{DynamicResource Settings.Fg.Primary}"/>
                            <TextBlock Text="Restore clipboard contents after the transcription is pasted"
                                       FontSize="11" Foreground="{DynamicResource Settings.Fg.Hint}"/>
                        </StackPanel>
                        <ToggleButton x:Name="RestoreClipboardToggle" Grid.Column="1"
                                      Style="{StaticResource Toggle}" VerticalAlignment="Center"/>
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource Settings.Line}"/>

                    <!-- Compress audio -->
                    <Grid Height="52">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Compress audio" FontSize="13"
                                       Foreground="{DynamicResource Settings.Fg.Primary}"/>
                            <TextBlock Text="Encode with Ogg/Opus before uploading — reduces data usage"
                                       FontSize="11" Foreground="{DynamicResource Settings.Fg.Hint}"/>
                        </StackPanel>
                        <ToggleButton x:Name="CompressAudioToggle" Grid.Column="1"
                                      Style="{StaticResource Toggle}" VerticalAlignment="Center"/>
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource Settings.Line}"/>

                    <!-- Skip silent -->
                    <Grid Height="52">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Skip silent recordings" FontSize="13"
                                       Foreground="{DynamicResource Settings.Fg.Primary}"/>
                            <TextBlock Text="Don't transcribe when no voice is detected"
                                       FontSize="11" Foreground="{DynamicResource Settings.Fg.Hint}"/>
                        </StackPanel>
                        <ToggleButton x:Name="SkipSilentToggle" Grid.Column="1"
                                      Style="{StaticResource Toggle}" VerticalAlignment="Center"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- ── PAGE: MODELS ────────────────────────────────────────────── -->
            <ScrollViewer x:Name="PageModels" Grid.Row="0"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20,24,20">
                    <TextBlock Text="Models" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Choose the transcription model. Different models offer different speed, accuracy and language support."
                               Style="{StaticResource PageSub}"/>

                    <StackPanel x:Name="ModelsPanel"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ── PAGE: API KEYS ──────────────────────────────────────────── -->
            <ScrollViewer x:Name="PageApiKeys" Grid.Row="0"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20,24,20">
                    <TextBlock Text="API Keys" Style="{StaticResource PageTitle}"/>

                    <!-- Info box -->
                    <Border Background="{DynamicResource Settings.InfoBox.Bg}"
                            BorderBrush="{DynamicResource Settings.InfoBox.Border}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Settings.Fg.Primary}"
                                       Text="🔒  API keys are stored encrypted with Windows DPAPI — locally on this machine, never uploaded."/>
                            <TextBlock x:Name="KeyStoragePath" FontSize="11"
                                       Foreground="{DynamicResource Settings.Fg.Secondary}"
                                       TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- OpenAI -->
                    <TextBlock Text="OPENAI" Style="{StaticResource SecHdr}" Margin="0,0,0,6"/>
                    <StackPanel Margin="0,0,0,4">
                        <TextBlock Text="OpenAI API Key" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource Settings.Fg.Primary}"
                                   Margin="0,0,0,3"/>
                        <TextBlock Text="Required for gpt-4o-transcribe. Get yours at platform.openai.com"
                                   FontSize="11" Foreground="{DynamicResource Settings.Fg.Hint}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="ApiKeyBox" Height="34"
                                         VerticalContentAlignment="Center"
                                         Padding="8,0" FontSize="13"/>
                            <TextBox x:Name="ApiKeyVisible" Height="34"
                                     VerticalContentAlignment="Center"
                                     Padding="8,0" FontSize="13"
                                     Visibility="Collapsed"/>
                            <Button x:Name="ShowKeyBtn" Grid.Column="1"
                                    Content="👁" Style="{StaticResource SmallBtn}"
                                    Margin="6,0,0,0" ToolTip="Show / hide key"
                                    Click="ShowKey_Click"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ── PAGE: HISTORY ───────────────────────────────────────────── -->
            <ScrollViewer x:Name="PageHistory" Grid.Row="0"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20,24,20">
                    <TextBlock Text="History" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Configure recording history and browse past transcriptions."
                               Style="{StaticResource PageSub}"/>

                    <TextBlock Text="SETTINGS" Style="{StaticResource SecHdr}"/>

                    <!-- Enable history -->
                    <Grid Height="52">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Enable history" FontSize="13"
                                       Foreground="{DynamicResource Settings.Fg.Primary}"/>
                            <TextBlock Text="Save audio recordings to disk"
                                       FontSize="11" Foreground="{DynamicResource Settings.Fg.Hint}"/>
                        </StackPanel>
                        <ToggleButton x:Name="EnableHistoryToggle" Grid.Column="1"
                                      Style="{StaticResource Toggle}" VerticalAlignment="Center"/>
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource Settings.Line}"/>

                    <!-- Save transcript text -->
                    <Grid Height="52">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Save transcription text" FontSize="13"
                                       Foreground="{DynamicResource Settings.Fg.Primary}"/>
                            <TextBlock Text="Store the transcribed text alongside each recording"
                                       FontSize="11" Foreground="{DynamicResource Settings.Fg.Hint}"/>
                        </StackPanel>
                        <ToggleButton x:Name="SaveTranscriptToggle" Grid.Column="1"
                                      Style="{StaticResource Toggle}" VerticalAlignment="Center"/>
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource Settings.Line}"/>

                    <!-- Max recordings -->
                    <Grid Height="52">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Max recordings kept" FontSize="13"
                                       Foreground="{DynamicResource Settings.Fg.Primary}"/>
                            <TextBlock Text="Oldest files deleted automatically when limit is reached"
                                       FontSize="11" Foreground="{DynamicResource Settings.Fg.Hint}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Content="−" Style="{StaticResource SmallBtn}"
                                    Click="HistoryCountDown_Click" Width="28"/>
                            <TextBlock x:Name="HistoryCountDisplay"
                                       Width="34" TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="13" FontFamily="Consolas"
                                       Foreground="{DynamicResource Settings.Fg.Primary}"
                                       Margin="4,0"/>
                            <Button Content="+" Style="{StaticResource SmallBtn}"
                                    Click="HistoryCountUp_Click" Width="28"/>
                        </StackPanel>
                    </Grid>

                    <!-- Open folder -->
                    <Button Content="Open recordings folder"
                            Style="{StaticResource SecondaryBtn}"
                            HorizontalAlignment="Left" Margin="0,8,0,0"
                            Click="OpenHistoryFolder_Click"/>

                    <!-- Recordings list -->
                    <TextBlock Text="RECORDINGS" Style="{StaticResource SecHdr}"/>
                    <StackPanel x:Name="HistoryList"/>
                    <TextBlock x:Name="HistoryEmpty"
                               Text="No recordings found."
                               Foreground="{DynamicResource Settings.Fg.Hint}"
                               FontSize="12" HorizontalAlignment="Center"
                               Margin="0,16,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ── PAGE: OVERLAY ───────────────────────────────────────────── -->
            <ScrollViewer x:Name="PageOverlay" Grid.Row="0"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20,24,20">
                    <TextBlock Text="Overlay" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Configure the floating recording indicator."
                               Style="{StaticResource PageSub}"/>

                    <TextBlock Text="VISIBILITY" Style="{StaticResource SecHdr}"/>

                    <!-- Show overlay -->
                    <Grid Height="52">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Show overlay" FontSize="13"
                                       Foreground="{DynamicResource Settings.Fg.Primary}"/>
                            <TextBlock Text="Display the floating indicator during recording"
                                       FontSize="11" Foreground="{DynamicResource Settings.Fg.Hint}"/>
                        </StackPanel>
                        <ToggleButton x:Name="OverlayVisibleToggle" Grid.Column="1"
                                      Style="{StaticResource Toggle}" VerticalAlignment="Center"/>
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource Settings.Line}"/>

                    <!-- Opacity -->
                    <Grid Height="52">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Opacity" FontSize="13"
                                       Foreground="{DynamicResource Settings.Fg.Primary}"/>
                            <TextBlock Text="Transparency of the overlay window"
                                       FontSize="11" Foreground="{DynamicResource Settings.Fg.Hint}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="12,0,0,0">
                            <Slider x:Name="OpacitySlider"
                                    Width="110" Minimum="0.2" Maximum="1.0"
                                    SmallChange="0.05" LargeChange="0.1"
                                    TickFrequency="0.05" VerticalAlignment="Center"
                                    Margin="0,0,8,0"
                                    ValueChanged="OpacitySlider_Changed"/>
                            <TextBlock x:Name="OpacityDisplay"
                                       Width="38" FontSize="12" FontFamily="Consolas"
                                       Foreground="{DynamicResource Settings.Fg.Primary}"
                                       VerticalAlignment="Center" TextAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource Settings.Line}"/>

                    <!-- Equalizer scroll speed -->
                    <Grid Height="52">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Equalizer scroll speed" FontSize="13"
                                       Foreground="{DynamicResource Settings.Fg.Primary}"/>
                            <TextBlock Text="How fast the waveform scrolls during recording"
                                       FontSize="11" Foreground="{DynamicResource Settings.Fg.Hint}"/>
                        </StackPanel>
                        <ComboBox x:Name="EqSpeedCombo" Grid.Column="1"
                                  Width="165" VerticalAlignment="Center" Margin="12,0,0,0">
                            <ComboBoxItem Content="Fast (75 ms)"       Tag="75"/>
                            <ComboBoxItem Content="Normal (150 ms)"    Tag="150"/>
                            <ComboBoxItem Content="Slow (300 ms)"      Tag="300"/>
                            <ComboBoxItem Content="Very Slow (600 ms)" Tag="600"/>
                        </ComboBox>
                    </Grid>

                    <!-- POSITION -->
                    <TextBlock Text="POSITION" Style="{StaticResource SecHdr}"/>

                    <!-- Anchor position -->
                    <Grid Height="46">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Anchor position" FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Settings.Fg.Primary}"/>
                        <ComboBox x:Name="OverlayPositionCombo" Grid.Column="1"
                                  Width="170" VerticalAlignment="Center" Margin="12,0,0,0">
                            <ComboBoxItem Content="Bottom Center" Tag="BottomCenter"/>
                            <ComboBoxItem Content="Bottom Left"   Tag="BottomLeft"/>
                            <ComboBoxItem Content="Bottom Right"  Tag="BottomRight"/>
                            <ComboBoxItem Content="Top Center"    Tag="TopCenter"/>
                            <ComboBoxItem Content="Top Left"      Tag="TopLeft"/>
                            <ComboBoxItem Content="Top Right"     Tag="TopRight"/>
                        </ComboBox>
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource Settings.Line}"/>

                    <!-- Vertical offset -->
                    <Grid Height="52">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Vertical offset (px)" FontSize="13"
                                       Foreground="{DynamicResource Settings.Fg.Primary}"/>
                            <TextBlock Text="Distance from top or bottom edge"
                                       FontSize="11" Foreground="{DynamicResource Settings.Fg.Hint}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Content="−" Style="{StaticResource SmallBtn}"
                                    Click="VOffDown_Click" Width="28"/>
                            <TextBlock x:Name="VOffDisplay"
                                       Width="40" TextAlignment="Center"
                                       VerticalAlignment="Center" FontSize="13"
                                       FontFamily="Consolas"
                                       Foreground="{DynamicResource Settings.Fg.Primary}"
                                       Margin="4,0"/>
                            <Button Content="+" Style="{StaticResource SmallBtn}"
                                    Click="VOffUp_Click" Width="28"/>
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource Settings.Line}"/>

                    <!-- Horizontal offset -->
                    <Grid Height="52">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Horizontal offset (px)" FontSize="13"
                                       Foreground="{DynamicResource Settings.Fg.Primary}"/>
                            <TextBlock Text="Distance from left or right edge"
                                       FontSize="11" Foreground="{DynamicResource Settings.Fg.Hint}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Content="−" Style="{StaticResource SmallBtn}"
                                    Click="HOffDown_Click" Width="28"/>
                            <TextBlock x:Name="HOffDisplay"
                                       Width="40" TextAlignment="Center"
                                       VerticalAlignment="Center" FontSize="13"
                                       FontFamily="Consolas"
                                       Foreground="{DynamicResource Settings.Fg.Primary}"
                                       Margin="4,0"/>
                            <Button Content="+" Style="{StaticResource SmallBtn}"
                                    Click="HOffUp_Click" Width="28"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ── FOOTER ──────────────────────────────────────────────────── -->
            <Border Grid.Row="1"
                    Background="{DynamicResource Settings.Footer.Bg}"
                    BorderBrush="{DynamicResource Settings.Line}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="24,11,24,11">
                    <Button Content="Cancel" Style="{StaticResource SecondaryBtn}"
                            Width="90" Margin="0,0,8,0"
                            Click="Cancel_Click" IsCancel="True"/>
                    <Button Content="Save" Style="{StaticResource PrimaryBtn}"
                            Width="90" Click="Save_Click" IsDefault="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
