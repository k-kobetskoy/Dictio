<Window x:Class="Dictio.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dictio — Settings"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">

        <Label Content="OpenAI API Key" FontWeight="SemiBold"/>
        <PasswordBox x:Name="ApiKeyBox" Margin="0,0,0,12"/>

        <Label Content="Microphone" FontWeight="SemiBold"/>
        <ComboBox x:Name="AudioDeviceCombo" Margin="0,0,0,12"/>

        <Label Content="Hotkey Mode  (Ctrl+Space)" FontWeight="SemiBold"/>
        <ComboBox x:Name="HotkeyModeCombo" Margin="0,0,0,20">
            <ComboBoxItem Content="Toggle (press once to start, once to stop)" Tag="Toggle"/>
            <ComboBoxItem Content="Push to Talk (hold to record, release to transcribe)" Tag="PushToTalk"/>
        </ComboBox>

        <!-- Transcription Language -->
        <Label Content="Transcription Language" FontWeight="SemiBold"/>
        <ComboBox x:Name="LanguageCombo" Margin="0,0,0,4"
                  SelectionChanged="LanguageCombo_SelectionChanged">
            <ComboBoxItem Content="Auto (detect)" Tag="Auto"/>
            <ComboBoxItem Content="English" Tag="English"/>
            <ComboBoxItem Content="Русский" Tag="Russian"/>
            <ComboBoxItem Content="Українська" Tag="Ukrainian"/>
        </ComboBox>
        <TextBlock Margin="0,0,0,12" Foreground="#888" FontSize="11" TextWrapping="Wrap">
            Sets the language the model transcribes in and applies the matching default prompt.
        </TextBlock>

        <!-- Default prompt preview -->
        <Label Content="Default Prompt" FontWeight="SemiBold"/>
        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="3" Margin="0,0,0,4">
            <TextBlock x:Name="DefaultPromptPreview"
                       Margin="8,6" FontSize="11" Foreground="#555"
                       TextWrapping="Wrap" FontStyle="Italic"/>
        </Border>
        <TextBlock Margin="0,0,0,12" Foreground="#888" FontSize="11" TextWrapping="Wrap">
            The prompt shows the model what clean output looks like: proper punctuation,
            no filler words or repetitions. It works by style example, not as instructions.
        </TextBlock>

        <!-- Custom prompt override -->
        <Label Content="Custom Prompt (optional)" FontWeight="SemiBold"/>
        <TextBox x:Name="CustomPromptBox" Margin="0,0,0,4"
                 TextWrapping="Wrap" AcceptsReturn="False" MaxLines="2"/>
        <TextBlock Margin="0,0,0,24" Foreground="#888" FontSize="11" TextWrapping="Wrap">
            Leave empty to use the default prompt above. Enter text here to override it —
            useful for domain-specific terms or names.
        </TextBlock>

        <!-- Temperature -->
        <Label Content="Transcription Temperature" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <Button Content="▼" Width="26" Click="TempDown_Click"/>
            <TextBlock x:Name="TemperatureDisplay" Width="36" TextAlignment="Center"
                       VerticalAlignment="Center" FontSize="13" Margin="4,0"/>
            <Button Content="▲" Width="26" Click="TempUp_Click"/>
            <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#888" FontSize="11">
                шаг 0.1 · – = не задано (API default)
            </TextBlock>
        </StackPanel>
        <TextBlock Margin="0,0,0,24" Foreground="#888" FontSize="11" TextWrapping="Wrap">
            Выше = больше разнообразия, меньше стабильности.
            Оставьте «–» если не уверены.
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Width="80" Margin="0,0,8,0" Click="Save_Click"
                    IsDefault="True"/>
            <Button Content="Cancel" Width="80" Click="Cancel_Click"
                    IsCancel="True"/>
        </StackPanel>

    </StackPanel>
</Window>
