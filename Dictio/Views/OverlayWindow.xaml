<Window x:Class="Dictio.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="60" Height="60"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        IsHitTestVisible="False">
    <Grid>
        <Ellipse Width="44" Height="44"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
            <Ellipse.Fill>
                <SolidColorBrush Color="#CCFF3B30"/>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <DropShadowEffect Color="#FF3B30" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/>
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="16" Height="16"
                 Fill="White"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>
    </Grid>
</Window>